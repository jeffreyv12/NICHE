# ============================================================================
# NicheFinder — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. The pre-commit hook should block it.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything
# else is server-only. If you add a variable, document it here in the same PR.
# ============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
NODE_ENV=development
# 'development' | 'preview' | 'production'

APP_ENV=local
# 'local' | 'preview' | 'staging' | 'production'

# Hostname of the main authority domain (the one that hosts niche subfolders
# until a niche graduates to its own domain). Example: 'expertgids.nl'.
PRIMARY_TENANT_HOSTNAME=

# Root URL for absolute links, emails, OG tags. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hard ceiling for monthly Claude API spend, EUR. Alert fires at 80%.
CLAUDE_MONTHLY_BUDGET_EUR=200

# Hard ceiling per single agent call, EUR. Kills the call if exceeded.
CLAUDE_PER_CALL_CAP_EUR=2.50

# ----------------------------------------------------------------------------
# Supabase (database + auth + storage + RLS)
# ----------------------------------------------------------------------------
# Project URL — from Supabase dashboard. EU Frankfurt region (eu-central-1).
NEXT_PUBLIC_SUPABASE_URL=

# Anon key — safe to expose to browser, used with RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for migrations (Drizzle).
DATABASE_URL=

# Connection-pooling URL (Supavisor) for app runtime.
DATABASE_POOL_URL=

# ----------------------------------------------------------------------------
# Anthropic Claude (Agent SDK + direct API)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Beta headers comma-separated, e.g. 'managed-agents-2026-04-01,prompt-caching-2024-07-31'.
ANTHROPIC_BETA_HEADERS=managed-agents-2026-04-01

# Model strings — locked. Do not change without updating CLAUDE.md too.
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_OPUS=claude-opus-4-7

# ----------------------------------------------------------------------------
# DataForSEO (keyword volume, SERPs, trends, autocomplete)
# ----------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Default queue: 'standard' (cheaper, async, ~few minutes) or 'live' (15× cost, <1s).
DATAFORSEO_QUEUE=standard

# ----------------------------------------------------------------------------
# Bol.com Partner — Marketing Catalog API + Affiliate Reporting API v2
# Get these from your affiliate dashboard → "API toegang" → "Reporting API".
# https://api.bol.com/marketing/docs/affiliate-reports-api/v2-api-documentation.html
# ----------------------------------------------------------------------------
BOL_PARTNER_CLIENT_ID=
BOL_PARTNER_CLIENT_SECRET=

# Subid prefix used when generating affiliate links. Free-text identifier,
# included in attribution reports. Keep it short — Bol truncates at 64 chars.
BOL_SUBID_PREFIX=nf

# Site code passed in deeplinks (siteCode parameter), for cross-tenant attribution.
BOL_SITE_CODE=nichefinder

# ----------------------------------------------------------------------------
# Awin (publisher API + product feed)
# Get from ui.awin.com → API credentials. €1 refundable security deposit required.
# ----------------------------------------------------------------------------
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# ----------------------------------------------------------------------------
# Daisycon (publisher API, OAuth2 PKCE)
# ----------------------------------------------------------------------------
DAISYCON_CLIENT_ID=
DAISYCON_CLIENT_SECRET=
DAISYCON_PUBLISHER_ID=

# ----------------------------------------------------------------------------
# Digistore24 (affiliate of digital products)
# ----------------------------------------------------------------------------
DIGISTORE_API_KEY=
DIGISTORE_VENDOR=
DIGISTORE_IPN_PASSPHRASE=

# ----------------------------------------------------------------------------
# Impact.com (premium brands)
# ----------------------------------------------------------------------------
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Cloudflare (Registrar API + DNS + bot management)
# ----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Registrar beta requires this scope on the token.
# See docs.cloudflare.com → Registrar API beta.

# ----------------------------------------------------------------------------
# TransIP (registrar for .nl and .be)
# ----------------------------------------------------------------------------
TRANSIP_LOGIN=
TRANSIP_PRIVATE_KEY=
# Private key is a long multi-line value. Use base64-encoded single line in env,
# decode in code. See packages/agent-sdk/src/registrars/transip.ts.

# ----------------------------------------------------------------------------
# Vercel (Domains API for attaching graduated-niche domains)
# ----------------------------------------------------------------------------
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ----------------------------------------------------------------------------
# Web search APIs (used by agents for SERP and fact-check verification)
# ----------------------------------------------------------------------------
# SerpAPI is optional; only used when DataForSEO queue is too slow for the use case.
SERPAPI_KEY=

# ----------------------------------------------------------------------------
# Email (Resend, transactional only at MVP)
# ----------------------------------------------------------------------------
RESEND_API_KEY=

# From-address for transactional emails. Must be on a domain verified in Resend.
EMAIL_FROM="NicheFinder <noreply@[main-domain]>"

# ----------------------------------------------------------------------------
# Analytics (cookieless first; PostHog for funnel)
# ----------------------------------------------------------------------------
# Plausible — set per tenant in the tenant config table, not in env.
# PostHog (EU cloud).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ----------------------------------------------------------------------------
# Error tracking
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----------------------------------------------------------------------------
# Google Search Console (GSC) — for branded-search detection in promotion gate
# OAuth2 service account or per-property API key. Set up via Google Cloud Console.
# ----------------------------------------------------------------------------
GSC_SERVICE_ACCOUNT_JSON=
# Single-line JSON, base64-encoded.

# ----------------------------------------------------------------------------
# Notifications (operator alerts — promotion ready, niche killed, budget alarm)
# ----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
# Or DISCORD_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# Scraper infrastructure (Hetzner-hosted)
# ----------------------------------------------------------------------------
SCRAPER_USER_AGENT="NicheFinder/1.0 (+https://[main-domain]/about-bot)"
SCRAPER_RATE_LIMIT_PER_HOST_RPS=1
SCRAPER_PROXY_URL=
# Optional: ScrapingBee or Bright Data residential proxy for fallback.

# ----------------------------------------------------------------------------
# Object storage (original photos, AI-generated images, agent traces)
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_MEDIA=nichefinder-media
CLOUDFLARE_R2_BUCKET_TRACES=nichefinder-agent-traces

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
FEATURE_AUTO_DOMAIN_REGISTRATION=false
# Even when 'true', user-approval gate remains. This flag enables the UI button.

FEATURE_BATCH_API=true
# Use Anthropic Batch API for nightly scoring runs (50% discount).

FEATURE_PROMPT_CACHE=true
# Use Anthropic prompt caching for repeated system prompts.

FEATURE_FAKE_TIMERS=false
# Tests only. Speeds up promotion-gate cooldown windows in CI.

# ----------------------------------------------------------------------------
# Admin
# ----------------------------------------------------------------------------
# Comma-separated list of email addresses that may sign in to /admin.
# Supabase auth checks this on the magic-link callback.
ADMIN_ALLOWED_EMAILS=
