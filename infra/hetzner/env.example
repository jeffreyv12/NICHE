# /etc/nichefinder/env — template. Mode 640, owner root:nichefinder.
# Real values are populated manually after provisioning; never commit.
# See repo-root .env.example for the full variable list.

# Core
NODE_ENV=production
APP_ENV=production
PRIMARY_TENANT_HOSTNAME=
NEXT_PUBLIC_APP_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BETA_HEADERS=managed-agents-2026-04-01
CLAUDE_MONTHLY_BUDGET_EUR=200
CLAUDE_PER_CALL_CAP_EUR=2.50

# Supabase (direct + pooled)
DATABASE_URL=
DATABASE_POOL_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Data sources (fill in as accounts come online)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
BOL_PARTNER_CLIENT_ID=
BOL_PARTNER_CLIENT_SECRET=
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
DAISYCON_CLIENT_ID=
DAISYCON_CLIENT_SECRET=
DAISYCON_PUBLISHER_ID=

# Notifications
SLACK_WEBHOOK_URL=

# Scraper UA
SCRAPER_USER_AGENT="NicheFinder/1.0 (+https://[main-domain]/about-bot)"
SCRAPER_RATE_LIMIT_PER_HOST_RPS=1

# Sentry (per-tenant tagging happens in code)
SENTRY_DSN=
