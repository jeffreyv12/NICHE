[Unit]
Description=NicheFinder Niche Monthly Metrics rollup — daily 03:00 NL
Documentation=docs/PROMOTION_GATE.md criteria 1-3 / docs/PHASE_PLAN.md Phase 5.4

[Timer]
# Daily, before the algorithm-events ingest (03:30) and the Sun 04:00
# promotion-eval, so the gate reads fresh per-niche revenue + organic-clicks
# closes (criteria 1-3) and the weekly orchestrator (Mon 06:00) and cost
# dashboard stay current. The job is pure SQL aggregation over a trailing
# window (no LLM cost), so daily is cheap and lets late conversions/refunds
# settle recent months.
OnCalendar=*-*-* 03:00:00
Persistent=true
Unit=nichefinder-runner@niche-monthly-metrics.service

[Install]
WantedBy=timers.target
